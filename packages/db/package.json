{
  "name": "@foundry/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src --exclude \"**/*.db.test.ts\"",
    "test:db": "vitest run --dir src \"db.test\"",
    "db:reset": "tsx src/scripts/reset-local.ts",
    "owner-code": "tsx src/scripts/owner-code.ts",
    "gen:migrations": "tsx src/scripts/gen-migrations.ts",
    "check:migrations": "tsx src/scripts/gen-migrations.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1146.0",
    "@foundry/contracts": "workspace:*",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
