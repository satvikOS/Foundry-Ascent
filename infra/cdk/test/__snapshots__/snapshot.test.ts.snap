exports[`template snapshots > FoundryAscent-Foundation 1`] = `
{
  "Description": "Foundry Ascent: GitHub OIDC provider and deploy role",
  "Outputs": {
    "GitHubDeployRoleArn": {
      "Description": "Role assumed by GitHub Actions (aws-actions/configure-aws-credentials role-to-assume)",
      "Value": {
        "Fn::GetAtt": [
          "GitHubDeployRoleED73FD64",
          "Arn",
        ],
      },
    },
    "GitHubOidcProviderArn": {
      "Value": {
        "Ref": "GitHubOidcProvider7EBF861F",
      },
    },
  },
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "GitHubDeployPolicyB814826B": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession",
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":role/cdk-hnb659fds-deploy-role-",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      "-us-east-1",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":role/cdk-hnb659fds-file-publishing-role-",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      "-us-east-1",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":role/cdk-hnb659fds-image-publishing-role-",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      "-us-east-1",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":role/cdk-hnb659fds-lookup-role-",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      "-us-east-1",
                    ],
                  ],
                },
              ],
              "Sid": "AssumeCdkBootstrapRoles",
            },
            {
              "Action": [
                "cloudformation:DescribeChangeSet",
                "cloudformation:DescribeStackEvents",
                "cloudformation:DescribeStackResource",
                "cloudformation:DescribeStackResources",
                "cloudformation:DescribeStacks",
                "cloudformation:GetTemplate",
                "cloudformation:ListStackResources",
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:cloudformation:us-east-1:",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":stack/CDKToolkit/*",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:cloudformation:us-east-1:",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":stack/FoundryAscent-*/*",
                    ],
                  ],
                },
              ],
              "Sid": "ReadPlatformStacks",
            },
            {
              "Action": "cloudformation:ListStacks",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "ListStacks",
            },
            {
              "Action": [
                "logs:FilterLogEvents",
                "logs:GetLogEvents",
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:logs:us-east-1:",
                    {
                      "Ref": "AWS::AccountId",
                    },
                    ":log-group:/aws/lambda/FoundryAscent*",
                  ],
                ],
              },
              "Sid": "ReadPlatformLambdaLogs",
            },
            {
              "Action": "ce:GetCostAndUsage",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "CostExplorerRead",
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "GitHubDeployPolicyB814826B",
        "Roles": [
          {
            "Ref": "GitHubDeployRoleED73FD64",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
    "GitHubDeployRoleED73FD64": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:satvikOS@228056784/Foundry-Ascent@1356439229:environment:production",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProvider7EBF861F",
                },
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "GitHub Actions deploys for satvikOS/Foundry-Ascent (OIDC; production environment only)",
        "MaxSessionDuration": 3600,
        "PermissionsBoundary": {
          "Fn::Join": [
            "",
            [
              "arn:aws:iam::",
              {
                "Ref": "AWS::AccountId",
              },
              ":policy/FoundryAscent-Boundary",
            ],
          ],
        },
        "RoleName": "FoundryAscent-GitHubDeploy",
      },
      "Type": "AWS::IAM::Role",
    },
    "GitHubOidcProvider7EBF861F": {
      "Properties": {
        "ClientIdList": [
          "sts.amazonaws.com",
        ],
        "Url": "https://token.actions.githubusercontent.com",
      },
      "Type": "AWS::IAM::OIDCProvider",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;
