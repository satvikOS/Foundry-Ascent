        "cloudformation:UpdateTerminationProtection"
      ],
      "resources": [
        "arn:aws:cloudformation:{region}:{account}:stack/CDKToolkit/00000000-0000-0000-0000-000000000000"
      ],
      "required": true
    },
    {
      "purpose": "CDK bootstrap: IAM roles created by the bootstrap template (CloudFormation uses the caller's permissions, incl. rollback)",
