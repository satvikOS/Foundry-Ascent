{
  "description": "Every IAM action the stage-0 CI identity (IAM user Foundry-Ascent) needs after the CDK bootstrap, with representative resource ARNs, and what it must NOT be able to do. ops/aws/test_policies.py (CI, offline) evaluates each action against each resource with the policy files in infra/iam/policies: a required entry that is not 'allowed' fails, and a required entry with \"expect\": \"denied\" fails when it IS allowed (privilege escalation, CDKToolkit or platform stack changes, deletion of platform data). Placeholders: {account} = caller account id (never printed), {region} = platform region (us-east-1). Literal regions are cross-region inference destinations. Resource '*' marks actions without resource-level scoping and legacy resources whose names are not known in advance. Every 'aws' CLI call in .github/workflows is listed here (ops/aws/test_policies.py checks the workflows against this file and the policy). The stage-0 access key was deleted on 2026-10-06, so this file now records what the published stage-0 policies grant and deny; nothing runs as that identity.",
  "cdk_qualifier": "hnb659fds",
  "entries": [
    {
      "purpose": "Caller identity (every workflow masks the account id first)",
      "actions": ["sts:GetCallerIdentity"],
      "resources": ["*"],
      "required": true
    },
    {
      "purpose": "Self-introspection: the stage-0 user reads its own policies, keys and login profile, and simulates its policies",
      "actions": [
        "iam:GetUser",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:GetUserPolicy",
        "iam:GetLoginProfile",
        "iam:ListAccessKeys",
        "iam:SimulatePrincipalPolicy"
      ],
      "resources": ["arn:aws:iam::{account}:user/Foundry-Ascent"],
      "required": true
    },
    {
      "purpose": "Deploy workflow: CDKToolkit status check (aws cloudformation describe-stacks)",
      "actions": ["cloudformation:DescribeStacks", "cloudformation:DescribeStackEvents"],
      "resources": [
        "arn:aws:cloudformation:{region}:{account}:stack/CDKToolkit/00000000-0000-0000-0000-000000000000"
      ],
      "required": true
    },
    {
      "purpose": "Deploy workflow: GitHub OIDC provider lookup (aws iam list-open-id-connect-providers)",
      "actions": ["iam:ListOpenIDConnectProviders"],
      "resources": ["*"],
      "required": true
    },
    {
      "purpose": "Deploy workflow: GitHub OIDC provider details",
      "actions": ["iam:GetOpenIDConnectProvider"],
      "resources": ["arn:aws:iam::{account}:oidc-provider/token.actions.githubusercontent.com"],
      "required": true
    },
    {
      "purpose": "Deploy workflow: Foundation stack resources (aws cloudformation describe-stack-resources) and platform stack status",
      "actions": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStackEvents",
        "cloudformation:GetTemplate"
      ],
      "resources": [
        "arn:aws:cloudformation:{region}:{account}:stack/FoundryAscent-Foundation/00000000-0000-0000-0000-000000000000",
        "arn:aws:cloudformation:{region}:{account}:stack/FoundryAscent-Data/00000000-0000-0000-0000-000000000000",
        "arn:aws:cloudformation:{region}:{account}:stack/FoundryAscent-App/00000000-0000-0000-0000-000000000000"
      ],
      "required": true
    },
    {
      "purpose": "Platform stack listing (no resource-level permissions)",
      "actions": ["cloudformation:ListStacks"],
      "resources": ["*"],
      "required": true
    },
    {
      "purpose": "CDK CLI (Deploy): assume the bootstrap deploy, asset publishing and lookup roles",
      "actions": ["sts:AssumeRole"],
      "resources": [
        "arn:aws:iam::{account}:role/cdk-hnb659fds-deploy-role-{account}-{region}",
        "arn:aws:iam::{account}:role/cdk-hnb659fds-file-publishing-role-{account}-{region}",
        "arn:aws:iam::{account}:role/cdk-hnb659fds-image-publishing-role-{account}-{region}",
        "arn:aws:iam::{account}:role/cdk-hnb659fds-lookup-role-{account}-{region}"
      ],
      "required": true
    },
    {
      "purpose": "CDK CLI: session tags when assuming bootstrap roles (only if configured)",
      "actions": ["sts:TagSession"],
      "resources": ["arn:aws:iam::{account}:role/cdk-hnb659fds-deploy-role-{account}-{region}"],
      "required": false
    },
    {
      "purpose": "CDK bootstrap version (read only; the CLI normally reads it through the deploy role)",
      "actions": ["ssm:GetParameter", "ssm:GetParameters"],
      "resources": ["arn:aws:ssm:{region}:{account}:parameter/cdk-bootstrap/hnb659fds/version"],
      "required": false
    },
    {
      "purpose": "Retire stage 0: the stage-1 deploy role and the permissions boundary exist",
      "actions": ["iam:GetRole"],
      "resources": ["arn:aws:iam::{account}:role/FoundryAscent-GitHubDeploy"],
      "required": true
    },
    {
      "purpose": "Permissions boundary FoundryAscent-Boundary (read only; the account owner publishes it)",
      "actions": ["iam:GetPolicy", "iam:GetPolicyVersion", "iam:ListPolicyVersions"],
      "resources": ["arn:aws:iam::{account}:policy/FoundryAscent-Boundary"],
      "required": true
    },
    {
      "purpose": "Bedrock smoke tests: model catalogue and inference profiles",
      "actions": ["bedrock:ListFoundationModels", "bedrock:ListInferenceProfiles"],
      "resources": ["*"],
      "required": true
    },
    {
      "purpose": "Bedrock smoke tests: model and profile details",
      "actions": ["bedrock:GetFoundationModel"],
      "resources": [
        "arn:aws:bedrock:{region}::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:{region}::foundation-model/amazon.titan-embed-text-v2:0"
      ],
      "required": true
    },
    {
      "purpose": "Bedrock smoke tests: inference profile details",
      "actions": ["bedrock:GetInferenceProfile"],
      "resources": [
        "arn:aws:bedrock:{region}:{account}:inference-profile/us.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:{region}:{account}:inference-profile/global.amazon.nova-2-lite-v1:0"
      ],
      "required": true
    },
    {
      "purpose": "The coach: Claude Haiku 4.5 via Converse / ConverseStream (its us. profile and the regions it routes to)",
      "actions": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "resources": [
        "arn:aws:bedrock:{region}:{account}:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:{region}::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ],
      "required": true
    },
    {
      "purpose": "Coach fallback and background reasoning: Amazon Nova 2 Lite via Converse / ConverseStream (base id and us./global. profiles)",
      "actions": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "resources": [
        "arn:aws:bedrock:{region}::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:{region}:{account}:inference-profile/us.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:{region}:{account}:inference-profile/global.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:::foundation-model/amazon.nova-2-lite-v1:0"
      ],
      "required": true
    },
    {
      "purpose": "Embeddings: Amazon Titan Text Embeddings V2 via InvokeModel",
      "actions": ["bedrock:InvokeModel"],
      "resources": ["arn:aws:bedrock:{region}::foundation-model/amazon.titan-embed-text-v2:0"],
      "required": true
    },
    {
      "purpose": "Primary reasoning: OpenAI GPT-6 Luna on bedrock-mantle (chat completions / responses, model list)",
      "actions": ["bedrock-mantle:CreateInference", "bedrock-mantle:ListModels"],
      "resources": ["*"],
      "required": true
    },
    {
      "purpose": "FinOps: Cost Explorer read (requires IAM access to billing data, activated by the root user)",
      "actions": ["ce:GetCostAndUsage", "ce:GetCostForecast", "ce:GetDimensionValues"],
      "resources": ["*"],
      "required": false
    },
    {
      "purpose": "FinOps: monthly AWS Budget (read only; the account owner creates and changes it)",
      "actions": ["budgets:ViewBudget"],
      "resources": ["arn:aws:budgets::{account}:budget/FoundryAscent-Monthly"],
      "required": false
    },
    {
      "purpose": "Self-retirement after stage 1: detach the stage-0 policies and delete the access keys",
      "actions": ["iam:DetachUserPolicy", "iam:DeleteAccessKey"],
      "resources": ["arn:aws:iam::{account}:user/Foundry-Ascent"],
      "required": true
    },
    {
      "purpose": "MUST BE DENIED: IAM role changes (privilege escalation through CDK or platform roles)",
      "actions": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PassRole",
        "iam:DeleteRole",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "resources": [
        "arn:aws:iam::{account}:role/cdk-hnb659fds-deploy-role-{account}-{region}",
        "arn:aws:iam::{account}:role/cdk-hnb659fds-cfn-exec-role-{account}-{region}",
        "arn:aws:iam::{account}:role/cdk-hnb659fds-example",
        "arn:aws:iam::{account}:role/FoundryAscent-GitHubDeploy",
        "arn:aws:iam::{account}:role/FoundryAscent-App-ApiRole-EXAMPLE"
      ],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: managed policy changes (permissions boundary and the stage-0 policies)",
      "actions": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:DeletePolicy"
      ],
      "resources": [
        "arn:aws:iam::{account}:policy/FoundryAscent-Boundary",
        "arn:aws:iam::{account}:policy/FoundryAscent-BootstrapOperator",
        "arn:aws:iam::{account}:policy/FoundryAscent-LegacyCleanup"
      ],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: new credentials or permissions for the stage-0 user",
      "actions": [
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "iam:DeleteUserPolicy",
        "iam:CreateLoginProfile",
        "iam:AddUserToGroup",
        "iam:PutUserPermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "resources": ["arn:aws:iam::{account}:user/Foundry-Ascent"],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: assuming any role other than the four CDK bootstrap roles",
      "actions": ["sts:AssumeRole"],
      "resources": [
        "arn:aws:iam::{account}:role/cdk-hnb659fds-cfn-exec-role-{account}-{region}",
        "arn:aws:iam::{account}:role/FoundryAscent-GitHubDeploy",
        "arn:aws:iam::{account}:role/cdk-hnb659fds-deploy-role-example"
      ],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: direct CloudFormation changes to CDKToolkit and the platform stacks (deploys go through the CDK deploy role)",
      "actions": [
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:UpdateTerminationProtection",
        "cloudformation:SetStackPolicy"
      ],
      "resources": [
        "arn:aws:cloudformation:{region}:{account}:stack/CDKToolkit/00000000-0000-0000-0000-000000000000",
        "arn:aws:cloudformation:{region}:{account}:stack/FoundryAscent-Foundation/00000000-0000-0000-0000-000000000000",
        "arn:aws:cloudformation:{region}:{account}:stack/FoundryAscent-Data/00000000-0000-0000-0000-000000000000",
        "arn:aws:cloudformation:{region}:{account}:stack/FoundryAscent-App/00000000-0000-0000-0000-000000000000"
      ],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: GitHub OIDC provider changes",
      "actions": [
        "iam:CreateOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint",
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider"
      ],
      "resources": ["arn:aws:iam::{account}:oidc-provider/token.actions.githubusercontent.com"],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: CDK bootstrap resources (staging bucket, container repository, version parameter)",
      "actions": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutBucketPolicy",
        "s3:DeleteBucket",
        "ecr:SetRepositoryPolicy",
        "ecr:DeleteRepository",
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "resources": [
        "arn:aws:s3:::cdk-hnb659fds-assets-{account}-{region}",
        "arn:aws:s3:::cdk-hnb659fds-assets-{account}-{region}/example.zip",
        "arn:aws:ecr:{region}:{account}:repository/cdk-hnb659fds-container-assets-{account}-{region}",
        "arn:aws:ssm:{region}:{account}:parameter/cdk-bootstrap/hnb659fds/version"
      ],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: platform data and runtime (Aurora, its secret, documents, functions, queues, logs)",
      "actions": [
        "rds:DeleteDBCluster",
        "rds:ModifyDBCluster",
        "rds:DeleteDBInstance",
        "secretsmanager:DeleteSecret",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "s3:PutLifecycleConfiguration",
        "lambda:DeleteFunction",
        "sqs:DeleteQueue",
        "sns:DeleteTopic",
        "logs:DeleteLogGroup",
        "events:DeleteRule"
      ],
      "resources": [
        "arn:aws:rds:{region}:{account}:cluster:foundry-ascent",
        "arn:aws:rds:{region}:{account}:db:foundry-ascent-writer",
        "arn:aws:secretsmanager:{region}:{account}:secret:foundry-ascent/aurora-admin-AbCdEf",
        "arn:aws:s3:::foundryascent-data-documentsbucket-example",
        "arn:aws:s3:::foundryascent-data-documentsbucket-example/tenants/example",
        "arn:aws:lambda:{region}:{account}:function:FoundryAscent-Api",
        "arn:aws:sqs:{region}:{account}:FoundryAscent-Jobs",
        "arn:aws:sns:{region}:{account}:FoundryAscent-Alarms",
        "arn:aws:logs:{region}:{account}:log-group:/aws/lambda/FoundryAscent-Api",
        "arn:aws:events:{region}:{account}:rule/FoundryAscent-App-DailyMaintenance-EXAMPLE"
      ],
      "required": true,
      "expect": "denied"
    },
    {
      "purpose": "MUST BE DENIED: budget changes (the account owner manages the budget)",
      "actions": ["budgets:ModifyBudget"],
      "resources": ["arn:aws:budgets::{account}:budget/FoundryAscent-Monthly"],
      "required": true,
      "expect": "denied"
    }
  ]
}
