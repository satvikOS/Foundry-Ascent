{
  "description": "Every IAM action the stage-0 CI identity (IAM user Foundry-Ascent) needs, with representative resource ARNs. ops/aws/verify_access.py simulates each action against each resource with iam:SimulatePrincipalPolicy; a required entry that is not 'allowed' fails the run. Placeholders: {account} = caller account id (never printed), {region} = platform region (us-east-1). Literal regions are cross-region inference destinations. Resource '*' marks actions without resource-level scoping and legacy resources whose names are not known in advance. Optional 'policy' (a customer-managed policy name): the entry applies only while that policy is attached directly to the calling IAM user (iam:ListAttachedUserPolicies). Once it is detached (FoundryAscent-LegacyCleanup is detached after the legacy cleanup), the entry is skipped instead of failing; if attachment cannot be determined, the entry is checked as declared.",
  "cdk_qualifier": "hnb659fds",
  "entries": [
    {
      "purpose": "Caller identity",
      "actions": ["sts:GetCallerIdentity"],
      "resources": ["*"],
      "required": true
    },
    {
      "purpose": "Self-introspection and access verification (verify_access.py)",
      "actions": [
        "iam:GetUser",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:ListAccessKeys",
        "iam:SimulatePrincipalPolicy"
      ],
      "resources": ["arn:aws:iam::{account}:user/Foundry-Ascent"],
      "required": true
    },
    {
      "purpose": "CDK bootstrap: CloudFormation change sets on stack CDKToolkit",
      "actions": [
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplate",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
