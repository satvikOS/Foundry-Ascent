{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "SelfIntrospectionAndRetirement",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:GetUserPolicy",
        "iam:GetLoginProfile",
        "iam:ListAccessKeys",
        "iam:SimulatePrincipalPolicy",
        "iam:DetachUserPolicy",
        "iam:DeleteAccessKey"
      ],
      "Resource": "arn:aws:iam::*:user/Foundry-Ascent"
    },
    {
      "Sid": "PolicySimulationContext",
      "Effect": "Allow",
      "Action": ["iam:GetContextKeysForPrincipalPolicy"],
      "Resource": "*"
    },
    {
      "Sid": "CloudFormationRead",
      "Effect": "Allow",
      "Action": ["cloudformation:Describe*", "cloudformation:List*", "cloudformation:Get*"],
      "Resource": "*"
    },
    {
      "Sid": "AssumeCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Resource": [
        "arn:aws:iam::????????????:role/cdk-hnb659fds-deploy-role-????????????-us-east-1",
        "arn:aws:iam::????????????:role/cdk-hnb659fds-file-publishing-role-????????????-us-east-1",
        "arn:aws:iam::????????????:role/cdk-hnb659fds-image-publishing-role-????????????-us-east-1",
        "arn:aws:iam::????????????:role/cdk-hnb659fds-lookup-role-????????????-us-east-1"
      ]
    },
    {
      "Sid": "CdkBootstrapVersionRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1:*:parameter/cdk-bootstrap/*"
    },
    {
      "Sid": "PlatformIdentityRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:GetOpenIDConnectProvider"
      ],
      "Resource": [
        "arn:aws:iam::*:role/cdk-hnb659fds-*",
        "arn:aws:iam::*:role/FoundryAscent-*",
        "arn:aws:iam::*:policy/FoundryAscent-*",
        "arn:aws:iam::*:oidc-provider/token.actions.githubusercontent.com"
      ]
    },
    {
      "Sid": "ListOidcProviders",
      "Effect": "Allow",
      "Action": ["iam:ListOpenIDConnectProviders"],
      "Resource": "*"
    },
    {
      "Sid": "ModelAccessSmokeTests",
      "Effect": "Allow",
      "Action": [
        "bedrock-mantle:CreateInference",
        "bedrock-mantle:List*",
        "bedrock-mantle:Get*",
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:ListInferenceProfiles",
        "bedrock:GetInferenceProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FinOpsRead",
      "Effect": "Allow",
      "Action": ["ce:GetCostAndUsage", "ce:GetCostForecast", "ce:GetDimensionValues", "budgets:ViewBudget"],
      "Resource": "*"
    },
    {
      "Sid": "NoIdentityChanges",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Create*",
        "iam:PassRole",
        "iam:Put*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Upload*"
      ],
      "Resource": "*"
    }
  ]
}
