{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "RetireThisUser",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:GetLoginProfile",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:ListAccessKeys",
        "iam:DetachUserPolicy",
        "iam:DeleteAccessKey"
      ],
      "Resource": "arn:aws:iam::*:user/Foundry-Ascent"
    }
  ]
}
