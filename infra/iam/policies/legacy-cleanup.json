{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InventoryRead",
      "Effect": "Allow",
      "Action": [
        "kms:List*",
        "kms:Describe*",
        "secretsmanager:ListSecrets",
        "secretsmanager:DescribeSecret",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "route53:List*",
        "route53:Get*",
        "route53domains:List*",
        "route53domains:Get*",
        "cloudfront:List*",
        "cloudfront:Get*",
        "iam:List*",
        "iam:Get*",
        "lambda:List*",
        "lambda:Get*",
        "apigateway:GET",
        "dynamodb:List*",
        "dynamodb:Describe*",
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "rds:Describe*",
        "rds:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecs:List*",
        "ecs:Describe*",
        "logs:Describe*",
        "sns:List*",
        "sns:Get*",
        "sqs:List*",
        "sqs:GetQueueAttributes",
        "cognito-idp:List*",
        "cognito-idp:Describe*",
        "ssm:DescribeParameters",
        "acm:List*",
        "acm:Describe*",
        "elasticache:Describe*",
        "amplify:List*",
        "amplify:Get*",
        "states:List*",
        "states:Describe*",
        "cloudwatch:Describe*",
        "cloudwatch:List*",
        "backup:List*",
        "backup:Describe*",
        "es:List*",
        "es:Describe*",
        "sagemaker:List*",
        "sagemaker:Describe*",
        "apprunner:List*",
        "apprunner:Describe*",
        "events:List*",
        "events:Describe*",
        "scheduler:List*",
        "scheduler:Get*",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LegacyResourceDeletion",
      "Effect": "Allow",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion",
        "kms:DisableKey",
        "kms:DeleteAlias",
        "secretsmanager:DeleteSecret",
        "secretsmanager:RestoreSecret",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "route53:ChangeResourceRecordSets",
        "route53:DeleteHostedZone",
        "cloudfront:UpdateDistribution",
        "cloudfront:Delete*",
        "lambda:Delete*",
        "apigateway:DELETE",
        "cloudformation:DeleteStack",
        "dynamodb:DeleteTable",
        "dynamodb:UpdateTable",
        "ec2:TerminateInstances",
        "ec2:DetachVolume",
        "ec2:ReleaseAddress",
        "ec2:DisassociateAddress",
        "ec2:DetachInternetGateway",
        "ec2:DisassociateRouteTable",
        "ec2:DeregisterImage",
        "ec2:Delete*",
        "elasticloadbalancing:Delete*",
        "rds:Delete*",
        "rds:ModifyDBInstance",
        "rds:ModifyDBCluster",
        "ecr:DeleteRepository",
        "ecr:BatchDeleteImage",
        "ecs:Delete*",
        "ecs:UpdateService",
        "ecs:DeregisterTaskDefinition",
        "logs:DeleteLogGroup",
        "sns:DeleteTopic",
        "sqs:DeleteQueue",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:UpdateUserPool",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "acm:DeleteCertificate",
        "elasticache:Delete*",
        "amplify:DeleteApp",
        "states:DeleteStateMachine",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DeleteDashboards",
        "backup:Delete*",
        "es:DeleteDomain",
        "sagemaker:Delete*",
        "sagemaker:StopNotebookInstance",
        "apprunner:DeleteService",
        "events:DeleteRule",
        "events:RemoveTargets",
        "scheduler:DeleteSchedule",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:DeleteInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:DeleteOpenIDConnectProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverDeleteTheOperatorIdentity",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUser",
        "iam:DeleteUserPolicy",
        "iam:DeleteLoginProfile",
        "iam:RemoveUserFromGroup"
      ],
      "Resource": "arn:aws:iam::*:user/Foundry-Ascent"
    }
  ]
}
